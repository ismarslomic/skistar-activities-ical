{
  // Using the tsconfig bases for Node24 https://github.com/tsconfig/bases/blob/main/bases/node24.json
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "preserveConstEnums": true,
    "rootDir": ".",
    "strict": false,
    "types": ["node", "vitest/globals"],
    "isolatedModules": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
