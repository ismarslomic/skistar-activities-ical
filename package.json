{
  "name": "skistar-activities-ical",
  "version": "1.0.0",
  "description": "Node.js app to generate iCal files for Skistar activities",
  "main": "index.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismarslomic/skistar-activities-ical.git"
  },
  "author": "ismar@slomic.no",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ismarslomic/skistar-activities-ical/issues"
  },
  "homepage": "https://github.com/ismarslomic/skistar-activities-ical",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "npx eslint .",
    "lint:report": "npx eslint . --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif",
    "lint:fix": "npx eslint . --fix",
    "prettier": "npx prettier --check .",
    "prettier:fix": "npx prettier --write .",
    "prepare": "is-ci || husky",
    "install:dep": "CI=true npm install --omit=dev",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "start": "npm run build && node dist/index.js"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@tsconfig/node22": "^22.0.6",
    "@tsconfig/node24": "^24.0.5",
    "@types/luxon": "^3.7.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nock": "^15.0.5",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@touch4it/ical-timezones": "^1.9.0",
    "axios": "^1.20.0",
    "ical-generator": "^11.1.2",
    "is-ci": "^4.1.0",
    "luxon": "^3.7.2",
    "morgan": "^1.12.1",
    "winston": "^3.19.0"
  }
}
